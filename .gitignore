# Ignore all node_modules directories
node_modules/
**/node_modules/

# Artefacts de test générés par Jest (coverage HTML/JSON/lcov/Cobertura XML,
# rapport JUnit) — régénérés à chaque `npm test`, ne doivent pas être versionnés.
coverage/
**/coverage/
reports/
**/reports/

# Archive du rapport HTML de couverture, créée par buildspec.yml pour être
# exportée dans les artefacts CodeBuild (US-02). Générée, donc non versionnée.
coverage-html.tar.gz
**/coverage-html.tar.gz

# Rapport SAST, produit par Semgrep dans buildspec.yml et dans ci.yml.
semgrep-report.json
**/semgrep-report.json

# Résultat du scan de vulnérabilités ECR (US-05), produit par buildspec.yml
# après le push de l'image.
ecr-scan-findings.json
**/ecr-scan-findings.json
scan-wait.err
**/scan-wait.err

# Fichiers de déploiement GÉNÉRÉS au build par buildspec.yml (à partir de
# taskdef.template.json, lui bien versionné) et par le dry-run de ci.yml.
# Ne jamais les committer : ils contiennent des valeurs propres à un compte AWS
# et à un build donné.
taskdef.json
**/taskdef.json
taskdef.rendered.json
**/taskdef.rendered.json
imageDetail.json
**/imageDetail.json